{
  "name": "dsh-tool-pwsh-safe-plus",
  "version": "0.2.9",
  "description": "DeepSeek Harness 的单一 PowerShell 执行路径：执行前自动修复 Bash 惯性语法，再以 base64 编码通过官方 ctx.shell 通道执行（转义免疫，兼容 dsh-win-pwsh7）。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.3 <0.3.0-0",
    "node": ">=18.0.0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "powershell",
    "pwsh",
    "tool",
    "auto-fix"
  ],
  "license": "MIT"
}
