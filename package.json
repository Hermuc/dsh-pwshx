{
  "name": "dsh-pwshx",
  "version": "0.1.0",
  "description": "DeepSeek Harness 的单一 PowerShell 执行路径：执行前自动修复 Bash 惯性语法、base64 编码执行，并内置 PowerShell 7 运行时检测、gate 与 UTF-8 代码页保障。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./typert": "./lib/typert.host.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-pwsh-local": ">=0.2.1",
    "@deepseek-ai/dsh-tools": ">=0.2.1",
    "@deepseek-ai/schemastery": ">=3.18.0"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.3 <0.3.0-0",
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Hermuc/dsh-pwshx.git"
  },
  "scripts": {
    "test": "node --test"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "powershell",
    "pwsh",
    "tool",
    "auto-fix",
    "runtime-gate"
  ]
}
