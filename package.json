{
  "name": "dsh-pwshx",
  "version": "0.1.0",
  "description": "DeepSeek Harness 的单一 PowerShell 执行入口：pwsh_safe 提供 auto-fix、坑位检查、danger-gate、base64、前台/后台任务与沙箱升级；官方 pwsh 可隐藏，运行时检测/gate/UTF-8 代码页保障内置。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./typert": "./lib/typert.host.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "icon.svg",
    "lib",
    "client.js",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-pwsh-local": ">=0.2.1",
    "@deepseek-ai/dsh-tools": ">=0.2.1",
    "@deepseek-ai/schemastery": ">=3.18.0",
    "@deepseek-ai/dsh-sandbox": ">=0.2.1"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.3 <0.3.0-0",
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "icon": "./icon.svg"
}
